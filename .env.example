OLLAMA_MODEL=llama3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
PORT=3001

# Optional: a smaller, faster model used only for the 3AM Companion chat.
# Remove this line to use OLLAMA_MODEL for the chat as well.
OLLAMA_CHAT_MODEL=llama3.2:3b

# Vision model for Nurse AI Vision (install with: ollama pull llava)
OLLAMA_VISION_MODEL=llava

# Optional: how long (in milliseconds) to wait for the AI to START
# answering. Once it is writing, it can take as long as it needs.
# Default 600000 = 10 minutes.
OLLAMA_TIMEOUT_MS=600000
